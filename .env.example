# Copiar a ".env" (desarrollo local) o a ".env.test" (VPS de prueba). NUNCA subir ese archivo a GitHub.

# Base de datos MySQL. Para la prueba use una base SEPARADA de la real.
# Formato: mysql://usuario:contraseña@servidor:3306/nombre_base
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/camp_test"

# Alternativa (recomendada en hosting): en vez de DATABASE_URL, definir estas 4 por separado.
# Si están las 4, tienen prioridad y la contraseña puede tener cualquier carácter.
# DB_HOST="localhost"
# DB_USER=""
# DB_PASSWORD=""
# DB_NAME=""

# Autenticación del panel de administración (cadena larga y aleatoria)
JWT_SECRET="cambie-esto-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3000
NODE_ENV="development"

# Dirección pública del formulario (sin "/" al final). Stripe vuelve a esta dirección después de pagar.
FRONTEND_URL="http://localhost:5173"

# Stripe (empiece SIEMPRE con claves de prueba: sk_test_...)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Cuota de registro en centavos (35000 = $350.00 CAD)
REGISTRATION_FEE_CENTS=35000

# Solo en el VPS de prueba: crear/actualizar las tablas y el administrador al arrancar.
# Quite ADMIN_PASSWORD de este archivo después del primer arranque.
AUTO_DB_PUSH=false
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
