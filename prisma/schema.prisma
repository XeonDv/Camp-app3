generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CampRegistration {
  id                        String   @id @default(uuid())

  campId                    String? @db.Text
  programSelection          String? @db.Text
  preferredStartDate        DateTime
  agencyName                String? @db.Text
  agencyEmail               String? @db.Text
  agencyPhone               String? @db.Text

  studentLastName           String @db.Text
  studentGivenName          String @db.Text
  studentNickName           String? @db.Text
  studentGender             String @db.Text
  studentDateOfBirth        DateTime
  studentAge                Int?
  studentNationality        String @db.Text
  studentPassportNumber     String @db.Text
  studentPassportIssueDate  DateTime?
  studentPassportExpiryDate DateTime?
  studentCurrentSchool      String? @db.Text
  studentGrade              String? @db.Text
  studentEmail              String? @db.Text
  studentPhone              String? @db.Text
  studentHomeAddress        String? @db.Text
  studentCity               String? @db.Text
  studentProvinceState      String? @db.Text
  studentCountry            String? @db.Text
  studentPostalCode         String? @db.Text

  parentFullName            String @db.Text
  parentRelationship        String? @db.Text
  parentPhone               String @db.Text
  parentEmail               String @db.Text
  parentOccupation          String? @db.Text

  emergencyContactLastName  String? @db.Text
  emergencyContactGivenName String? @db.Text
  emergencyContactPhone     String? @db.Text
  emergencyContactEmail     String? @db.Text

  accompanyingParent1LastName    String? @db.Text
  accompanyingParent1GivenName   String? @db.Text
  accompanyingParent1Relation    String? @db.Text
  accompanyingParent1DateOfBirth DateTime?
  accompanyingParent1Age         Int?
  accompanyingParent1Gender      String? @db.Text
  accompanyingParent1Nationality String? @db.Text
  accompanyingParent1PassportNumber String? @db.Text
  accompanyingParent1PassportExpiry DateTime?
  accompanyingParent1Phone       String? @db.Text
  accompanyingParent1Email       String? @db.Text

  accompanyingParent2LastName    String? @db.Text
  accompanyingParent2GivenName   String? @db.Text
  accompanyingParent2Relation    String? @db.Text
  accompanyingParent2DateOfBirth DateTime?
  accompanyingParent2Age         Int?
  accompanyingParent2Gender      String? @db.Text
  accompanyingParent2Nationality String? @db.Text
  accompanyingParent2PassportNumber String? @db.Text
  accompanyingParent2PassportExpiry DateTime?
  accompanyingParent2Phone       String? @db.Text
  accompanyingParent2Email       String? @db.Text

  englishLevel                  String? @db.Text
  ieltsOverall                  String? @db.Text
  ieltsDate                     DateTime?
  toeflScore                    String? @db.Text
  toeflDate                     DateTime?
  otherCertificate              String? @db.Text
  studentStrengths              String? @db.Text
  studentInterests              String? @db.Text
  previousInternationalExperience String? @db.Text
  previousExperienceDetails     String? @db.Text

  generalHealthCondition        String? @db.Text
  allergies                     String? @db.Text
  medicalConditions             String? @db.Text
  medications                   String? @db.Text
  specialDietary                String? @db.Text
  hasAllergies                  Boolean?
  allergiesDetails              String? @db.Text
  hasChronicIllness             Boolean?
  chronicIllnessDetails         String? @db.Text
  regularMedication             String? @db.Text
  specialDiet                   String? @db.Text
  specialDietDetails            String? @db.Text
  specialNeeds                  String? @db.Text

  travelArrangement             String? @db.Text
  accommodationType             String @db.Text
  accommodationOther            String? @db.Text

  arrivalAirline                String? @db.Text
  arrivalFlightNumber           String? @db.Text
  arrivalDepartureAirport       String? @db.Text
  arrivalAirportToronto         String? @db.Text
  arrivalDateTime               DateTime?
  departureAirline              String? @db.Text
  departureFlightNumber         String? @db.Text
  departureDateTime             DateTime?
  flightSpecialRequests         String? @db.Text

  activityParticipationConsent Boolean @default(false)
  activityRiskAcceptance       Boolean @default(false)
  activityLiabilityRelease     Boolean @default(false)
  propertyRespectAgreement     Boolean @default(false)
  propertyDamageResponsibility Boolean @default(false)
  medicalInfoAccuracy          Boolean @default(false)
  allergyEnvironmentUnderstanding Boolean @default(false)
  emergencyInsuranceUnderstanding Boolean @default(false)
  emergencyTreatmentAuthorization Boolean @default(false)
  medicalCostResponsibility    Boolean @default(false)
  privacyPolicyUnderstanding   Boolean @default(false)
  mediaConsent                 String  @default("yes")
  informationTruthConfirmation Boolean @default(false)
  applicationFormUnderstanding Boolean @default(false)
  campRulesAgreement           Boolean @default(false)
  consentWaiverSignAgreement   Boolean @default(false)

  parentGuardianFullName       String? @db.Text
  parentGuardianRelation       String? @db.Text
  parentSignature              String? @db.Text
  signatureDate                DateTime?

  // ---- Formulario 2027 (columnas nuevas, todas opcionales para no afectar registros anteriores) ----
  formVersion                  String   @default("2026")
  studentMotherTongue          String? @db.Text
  emergencyContactName         String? @db.Text
  emergencyContactRelationship String? @db.Text
  currentlyInCanada            Boolean?
  canadaAddress                String? @db.Text
  agencyContactPerson          String? @db.Text

  parentDateOfBirth            DateTime?
  parent2FullName              String? @db.Text
  parent2DateOfBirth           DateTime?
  parent2Email                 String? @db.Text
  parent2Phone                 String? @db.Text

  campCentre                   String? @db.Text
  durationWeeks                Int?
  departureDate                DateTime?
  parentAccommodation          String? @db.Text
  academicProgram              String? @db.Text
  airportTransfer              String? @db.Text
  frenchCanadaTour             Boolean?
  notarizedCustodyLetter       Boolean?
  officialCertificate          Boolean?
  additionalNightStays         Json?
  placementTest                String? @db.Text
  termsAccepted                Boolean?

  // ---- Pago con Stripe ----
  stripeSessionId              String? @db.Text
  stripePaymentIntentId        String? @db.Text
  paidAt                       DateTime?

  status                       String  @default("pending")
  paymentStatus                String  @default("unpaid")
  paymentAmount                Decimal?
  notes                        String? @db.Text
  pdfUrl                       String? @db.Text

  registrationDate             DateTime @default(now())
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("camp_registrations")
}

model CampProgram {
  id          String   @id @default(uuid())
  name        String
  description String
  dates       Json     // Array of { startDate: string, endDate: string }
  capacity    Int
  enrolled    Int      @default(0)
  ageRangeMin Int
  ageRangeMax Int
  price       Decimal
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("camp_programs")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
